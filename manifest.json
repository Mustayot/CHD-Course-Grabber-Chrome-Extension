{
  "manifest_version": 3,
  "name": "长大教务抢课助手",
  "version": "1.0.0",
  "description": "长安大学本科教务系统(eams)自动抢课：自动爬取课程/教学班ID，可视化UI，多课程优先级抢课，快速/蹲守双模式，防封退避",
  "permissions": ["storage"],
  "host_permissions": [
    "http://bkjw.chd.edu.cn/*",
    "https://bkjw.chd.edu.cn/*"
  ],
  "action": {
    "default_title": "长大教务抢课助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://bkjw.chd.edu.cn/eams/*",
        "https://bkjw.chd.edu.cn/eams/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
